    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ---------------------------------------------------------------------------\n// Normaliza lo que entrega el Error Trigger. Cambia de forma según si el fallo\n// ocurrió dentro de una ejecución o al disparar el trigger, así que leemos\n// ambas variantes en vez de asumir una.\n// ---------------------------------------------------------------------------\nconst d = $json ?? {};\nconst eje = d.execution ?? d.trigger ?? {};\nconst wf  = d.workflow ?? {};\n\nconst mensaje = String(\n  eje.error?.message ?? d.error?.message ?? eje.error ?? 'Error sin mensaje'\n).slice(0, 500);\n\nconst nodo = String(eje.lastNodeExecuted ?? eje.error?.node?.name ?? 'desconocido');\n\n// Fallos que no son culpa del workflow y no hay que perseguir a las 3 de la\n// mañana: se reintentan solos en la siguiente corrida.\nconst TRANSITORIO = /ECONNRESET|ETIMEDOUT|ENOTFOUND|EAI_AGAIN|socket hang up|too many requests|rate.?limit|503|502|504/i;\nconst esTransitorio = TRANSITORIO.test(mensaje);\n\n// Fallos que dejan el servicio muerto hasta que un humano actúe.\nconst CRITICO = /token|credential|unauthorized|401|403|invalid.?grant|quota/i;\nconst esCritico = CRITICO.test(mensaje);\n\nconst gravedad = esCritico ? 'critico' : esTransitorio ? 'transitorio' : 'revisar';\n\nconst ICONO = { critico: '🔴', revisar: '🟠', transitorio: '🟡' };\nconst NOTA = {\n  critico: 'Servicio caído hasta que alguien lo arregle. Revisa credenciales o token de Meta.',\n  revisar: 'Fallo no clasificado. Abre la ejecución y mira qué pasó.',\n  transitorio: 'Problema de red o límite de peticiones. Se reintenta solo en la próxima corrida.',\n};\n\nreturn { json: {\n  timestamp: new Date().toISOString(),\n  workflow: String(wf.name ?? 'desconocido'),\n  nodo,\n  ejecucion_id: String(eje.id ?? ''),\n  mensaje,\n  url_ejecucion: String(eje.url ?? ''),\n  gravedad,\n  // Los transitorios se registran pero no despiertan a nadie.\n  notificar: gravedad !== 'transitorio',\n  texto_alerta: [\n    ICONO[gravedad] + ' Fallo en «' + String(wf.name ?? '?') + '»',\n    'Nodo: ' + nodo,\n    'Error: ' + mensaje,\n    NOTA[gravedad],\n    eje.url ? 'Ejecución: ' + eje.url : '',\n  ].filter(Boolean).join('\\n'),\n}};"
      },
